<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="clr-namespace:CloudlogHelper.Resources"
             xmlns:stepVm="clr-namespace:CloudlogHelper.ViewModels.WizardSteps"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="450"
             x:Class="CloudlogHelper.Views.WizardSteps.WelcomeWizardStepView"
             x:DataType="stepVm:WelcomeWizardStepViewModel">
    <Border Classes="highlight-card" Padding="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
            <Border Width="64"
                    Height="64"
                    CornerRadius="18"
                    Padding="12"
                    Background="#332878B8"
                    VerticalAlignment="Top">
                <Image Width="40"
                       Height="40"
                       Source="avares://CloudlogHelper/Assets/icon.png" />
            </Border>

            <StackPanel Grid.Column="1"
                        MinWidth="0"
                        Spacing="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="{I18N {x:Static resources:LangKeys.WizardHiThere}}"
                           Classes="section-title" />
                <TextBlock Text="{I18N {x:Static resources:LangKeys.WizardWelcomeMessage}}"
                           Classes="page-hint"
                           HorizontalAlignment="Stretch"
                           TextWrapping="Wrap"
                           FontSize="14" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
