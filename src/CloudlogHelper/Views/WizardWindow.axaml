<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:resources="clr-namespace:CloudlogHelper.Resources"
        xmlns:viewModels="clr-namespace:CloudlogHelper.ViewModels"
        xmlns:stepVm="clr-namespace:CloudlogHelper.ViewModels.WizardSteps"
        xmlns:stepViews="clr-namespace:CloudlogHelper.Views.WizardSteps"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="700"
        x:Class="CloudlogHelper.Views.WizardWindow"
        x:Name="WizardRoot"
        x:DataType="viewModels:WizardWindowViewModel"
        Title="{I18N {x:Static resources:LangKeys.WizardTitle}}"
        Width="900"
        Height="700"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Icon="avares://CloudlogHelper/Assets/icon.png">

    <Window.Styles>
        <!-- ==================== 文本 ==================== -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style Selector="TextBlock.page-hint">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style Selector="TextBlock.subsection-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style Selector="TextBlock.setting-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0 0 12 0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style Selector="TextBox.setting-control, ComboBox.setting-control">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ==================== 面板 ==================== -->
        <!-- 特性提示（启用开关、欢迎语） -->
        <Style Selector="Border.highlight-card">
            <Setter Property="Background" Value="#182878B8" />
            <Setter Property="BorderBrush" Value="#332878B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- 次级分组（日志系统卡片等），去掉外层卡片套卡片的层级 -->
        <Style Selector="Border.subsection-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- 警告提示（后端初始化失败） -->
        <Style Selector="Border.notice-warning">
            <Setter Property="Background" Value="#26FFC107" />
            <Setter Property="BorderBrush" Value="#FFC107" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.notice-warning TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- 检测到的实例小标签 -->
        <Style Selector="Border.feature-chip">
            <Setter Property="Background" Value="#182878B8" />
            <Setter Property="BorderBrush" Value="#332878B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10 5" />
        </Style>

        <!-- 步骤计数 -->
        <Style Selector="Border.step-chip">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12 5" />
        </Style>

        <!-- ==================== 侧边栏步骤 ==================== -->
        <Style Selector="Button.step-nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style Selector="Button.step-nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        </Style>

        <Style Selector="Button.step-nav:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Border.step-badge">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.step-nav:pointerover Border.step-badge">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>

        <!-- ==================== 导航按钮 ==================== -->
        <Style Selector="Button.nav-primary">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="18 9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.nav-primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorDark1}" />
        </Style>

        <Style Selector="Button.nav-primary:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorDark2}" />
        </Style>

        <Style Selector="Button.nav-secondary">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="18 9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.nav-secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        </Style>

        <Style Selector="Button.footer-link">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.footer-link:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid Margin="20">
        <Grid ColumnDefinitions="252,*" ColumnSpacing="24">
            <!-- ==================== 左侧：步骤导航 ==================== -->
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="6" Margin="2,0,0,18">
                    <Image Width="32" Height="32" Source="avares://CloudlogHelper/Assets/icon.png" />
                    <TextBlock Text="{I18N {x:Static resources:LangKeys.WizardTitle}}"
                               Classes="section-title"
                               FontSize="16" />
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="step-nav"
                                    IsEnabled="{Binding CanNavigate}"
                                    Command="{Binding ElementName=WizardRoot, Path=DataContext.NavigateCommand}"
                                    CommandParameter="{Binding Index}">
                                <Panel>
                                    <!-- 当前步骤：底色 + 左侧 accent 竖条。用叠层而非切换颜色，
                                         避免模板内出现依赖否定绑定或主题假设的配色 -->
                                    <Border CornerRadius="10"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            IsVisible="{Binding IsCurrent}" />
                                    <Border Width="3" Height="18" CornerRadius="2"
                                            Background="{DynamicResource SystemAccentColor}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            IsVisible="{Binding IsCurrent}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                                          Margin="16,0,10,0">
                                        <Border Classes="step-badge" VerticalAlignment="Center">
                                            <avalonia:MaterialIcon Kind="{Binding IconKind}"
                                                                   Width="13" Height="13"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="13" />
                                        <avalonia:MaterialIcon Grid.Column="2" Kind="Check"
                                                               Width="14" Height="14"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.6"
                                                               IsVisible="{Binding IsVisited}" />
                                    </Grid>
                                </Panel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="2"
                        Classes="footer-link"
                        HorizontalAlignment="Left"
                        Margin="2,0,0,0"
                        Command="{Binding OpenGithubProfileCommand}">
                    <avalonia:MaterialIcon Kind="MicrosoftGithub" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- ==================== 右侧：内容 ==================== -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding CurrentStepTitle}" Classes="page-title" />
                        <TextBlock Text="{Binding CurrentStepDescription}" Classes="page-hint" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="step-chip" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepIndicatorText}"
                                   FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0 2 6 2">
                    <ContentControl Content="{Binding CurrentStep}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="stepVm:WelcomeWizardStepViewModel">
                                <stepViews:WelcomeWizardStepView />
                            </DataTemplate>
                            <DataTemplate DataType="stepVm:BasicWizardStepViewModel">
                                <stepViews:BasicWizardStepView />
                            </DataTemplate>
                            <DataTemplate DataType="stepVm:CloudlogWizardStepViewModel">
                                <stepViews:CloudlogWizardStepView />
                            </DataTemplate>
                            <DataTemplate DataType="stepVm:ThirdPartyWizardStepViewModel">
                                <stepViews:ThirdPartyWizardStepView />
                            </DataTemplate>
                            <DataTemplate DataType="stepVm:RigBackendWizardStepViewModel">
                                <stepViews:RigBackendWizardStepView />
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Padding="0 14 0 0"
                        BorderBrush="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="{I18N {x:Static resources:LangKeys.WizardSkip}}"
                                IsVisible="{Binding ShowSkipButton}"
                                Command="{Binding SkipWizardCommand}"
                                Classes="nav-secondary" />
                        <Button Content="{I18N {x:Static resources:LangKeys.WizardPrevious}}"
                                IsVisible="{Binding ShowPreviousButton}"
                                Command="{Binding PreviousCommand}"
                                Classes="nav-secondary" />
                        <Button Content="{I18N {x:Static resources:LangKeys.WizardNext}}"
                                IsVisible="{Binding ShowNextButton}"
                                Command="{Binding NextCommand}"
                                Classes="nav-primary" />
                        <Button Content="{I18N {x:Static resources:LangKeys.WizardFinish}}"
                                IsVisible="{Binding ShowFinishButton}"
                                Command="{Binding FinishCommand}"
                                Classes="nav-primary" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
